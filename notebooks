    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Select features (X) and target variable (y)\n",
        "\n",
        "feature_columns = [\n",
        "    \"age\",\n",
        "    \"distance_km\",\n",
        "    \"fee_inr\",\n",
        "    \"lead_days\",\n",
